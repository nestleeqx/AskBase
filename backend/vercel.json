{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,scripts/**,.venv/**,.pytest_cache/**,.ruff_cache/**,Dockerfile,app/seed/source/**,app/seed/eval-*.json}"
    }
  },
  "crons": [{ "path": "/api/cron/cleanup", "schedule": "0 3 * * *" }]
}
