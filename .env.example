# Скопируйте в .env: cp .env.example .env

# --- Нейросеть для ответов ---
# Пусто — openai, если задан OPENAI_API_KEY, иначе mock (ответ первым найденным фрагментом).
# openai — любой OpenAI-совместимый API; yandex — YandexGPT, данные не покидают РФ
LLM_PROVIDER=
OPENAI_MODEL=gpt-4o-mini
# Для моделей GPT-5 и o-серии: none, minimal, low, medium, high. Пусто — не передаётся
OPENAI_REASONING_EFFORT=
# json_schema для OpenAI/OpenRouter; json_object для API без поддержки строгих схем (DeepSeek)
OPENAI_JSON_MODE=json_schema
YANDEX_MODEL=yandexgpt/latest

# --- Эмбеддинги (поиск по смыслу) ---
# Достаточно OPENAI_API_KEY: тогда поиск работает через OpenAI. Без ключа — mock,
# простое сравнение слов без внешнего API (для проверки, что всё запускается).
# openai — любой OpenAI-совместимый API; yandex — Yandex Foundation Models, данные не покидают РФ
EMBEDDING_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# --- Telegram-бот ---
# Токен от @BotFather. Пусто — бот выключен. Локально бот работает в сервисе bot (docker compose)
TELEGRAM_BOT_TOKEN=
# Чат менеджера: сюда бот пишет о заявках на запись и вопросах, которые ждут человека.
# Id своего чата бот подскажет по команде /myid. Пусто — уведомлений нет
MANAGER_CHAT_ID=
# Сколько минут бот молчит в чате после ответа администратора из админки
OPERATOR_MINUTES=30
# Контакты клиники в ответе «Связаться с администратором»
CLINIC_PHONE=+7 (343) 200-18-18
CLINIC_HOURS=пн–пт 9:00–21:00, сб 9:00–16:00

# --- Защита бюджета публичного демо ---
MAX_QUESTION_CHARS=500
QUESTIONS_PER_HOUR=30
SEARCHES_PER_HOUR=60
UPLOADS_PER_HOUR=10
# Свои документы гостя: сколько, какого размера; через сутки удаляются
GUEST_DOCS_LIMIT=3
MAX_UPLOAD_MB=2
MAX_PDF_PAGES=20
MAX_DOC_CHARS=50000

# --- Инфраструктура (для запуска без Docker) ---
# Подходят и строки вида postgres://…?sslmode=require (Neon, Supabase) — они приводятся к asyncpg.
# Нужен Postgres с расширением pgvector
DATABASE_URL=postgresql+asyncpg://askbase:askbase@localhost:5434/askbase
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=http://localhost:3000
# Регулярка для превью-деплоев, например ^https://askbase-.*\.vercel\.app$
CORS_ORIGIN_REGEX=
# Адрес сайта, где лежит страница «Правила записи». Пусто — первый адрес из CORS_ORIGINS
SITE_URL=
# Секрет для Vercel Cron, который раз в сутки удаляет документы гостей старше суток
CRON_SECRET=
