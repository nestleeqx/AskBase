# Скопируйте в .env: cp .env.example .env

# --- Эмбеддинги (поиск по смыслу) ---
# Достаточно OPENAI_API_KEY: тогда поиск работает через OpenAI. Без ключа — mock,
# простое сравнение слов без внешнего API (для проверки, что всё запускается).
# openai — любой OpenAI-совместимый API; yandex — Yandex Foundation Models, данные не покидают РФ
EMBEDDING_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# --- Защита бюджета публичного демо ---
MAX_QUESTION_CHARS=500
SEARCHES_PER_HOUR=60
UPLOADS_PER_HOUR=10
# Свои документы гостя: сколько, какого размера; через сутки удаляются
GUEST_DOCS_LIMIT=3
MAX_UPLOAD_MB=2
MAX_PDF_PAGES=20
MAX_DOC_CHARS=50000

# --- Инфраструктура (для запуска без Docker) ---
# Подходят и строки вида postgres://…?sslmode=require (Neon, Supabase) — они приводятся к asyncpg.
# Нужен Postgres с расширением pgvector
DATABASE_URL=postgresql+asyncpg://askbase:askbase@localhost:5434/askbase
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=http://localhost:3000
# Регулярка для превью-деплоев, например ^https://askbase-.*\.vercel\.app$
CORS_ORIGIN_REGEX=
# Адрес сайта, где лежит страница «Правила записи». Пусто — первый адрес из CORS_ORIGINS
SITE_URL=
# Секрет для Vercel Cron, который раз в сутки удаляет документы гостей старше суток
CRON_SECRET=
